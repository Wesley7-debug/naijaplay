{
  "name": "@naijaplay/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx src/seed/seed.ts",
    "unseed": "tsx src/seed/unseed.ts"
  },
  "dependencies": {
    "@naijaplay/shared": "*",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "4.22.3",
    "express-mongo-sanitize": "2.2.0",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "mongoose": "8.24.5",
    "multer": "1.4.5-lts.2",
    "nodemailer": "10.0.15",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "socket.io": "4.8.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/multer": "1.4.13",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.4.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
