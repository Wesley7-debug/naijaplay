# ---- Core ----
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/naijaplay
SESSION_SECRET=change-me-to-a-long-random-string
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# ---- Auth: Google OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Auth: Email magic links ----
# log = print to server console (local dev). gmail = real delivery via Gmail SMTP.
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM="NaijaPlay <no-reply@naijaplay.com>"
# Gmail SMTP (needs a Google App Password, NOT your login password):
# Google Account → Security → 2-Step Verification ON → App passwords → Mail → copy the 16-letter code.
# EMAIL_PROVIDER=gmail
# EMAIL_GMAIL_USER=you@gmail.com
# EMAIL_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# EMAIL_FROM="NaijaPlay <you@gmail.com>"

# ---- Payments ----
# No online checkout. Money moves by manual bank transfer (aza) in chat.

# ---- Media: Cloudinary ----
# Blank = local disk storage in ./server/uploads served at /uploads (dev only; prod requires Cloudinary).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Optional ----
LOG_LEVEL=info
# Set to 1 when running behind Render/Railway/Vercel proxies (rate-limit IPs).
RATE_LIMIT_TRUST_PROXY=
# Only for rate-limit tests: TEST_RATE_LIMIT=1
# Split-origin deploys (app + api on subdomains of one parent domain):
# COOKIE_DOMAIN=.naijaplay.com — lets both hosts share the session cookie.
# Single-service deploys don't need this.
# Single-service publish (serve client/dist from the API origin): SERVE_CLIENT=1
# Override the served directory (default: ../client/dist): CLIENT_DIST=
