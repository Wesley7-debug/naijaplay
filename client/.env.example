# NaijaPlay client env (Vite). Copy to `.env` for local dev.
# On Vercel, set these in Project Settings → Environment Variables instead.

# Backend base URL — Google OAuth start + Vite dev proxy target for /api, /uploads, /socket.io
VITE_API_URL=http://localhost:4000

# Public frontend URL — share links / absoluteUrl()
VITE_APP_URL=http://localhost:5173
